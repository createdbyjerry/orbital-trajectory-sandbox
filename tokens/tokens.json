    },
    "sheet": {
      "$value": "0.28s",
      "$description": "Mobile sheet slide-in / dock button state"
    }
  },
  "shadow": {
    "$type": "shadow",
    "panel": {
      "$description": "Floating glass panels",
      "$value": [
        {
          "offsetX": "0",
          "offsetY": "20px",
          "blur": "60px",
          "spread": "0",
          "color": "rgba(0,0,0,0.55)"
        },
        {
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "0",
          "spread": "0",
          "color": "rgba(255,255,255,0.06)",
          "inset": true
        }
      ]
    },
    "sheet": {
      "$description": "Mobile bottom sheet / dock (casts upward)",
      "$value": [
        {
          "offsetX": "0",
          "offsetY": "-12px",
          "blur": "40px",
          "spread": "0",
          "color": "rgba(0,0,0,0.6)"
        },
        {
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "0",
          "spread": "0",
          "color": "rgba(255,255,255,0.06)",
          "inset": true
        }
      ]
    }
  },
