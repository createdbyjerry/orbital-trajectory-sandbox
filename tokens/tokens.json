      "$description": "Width of the side sheet on landscape phones"
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "mobile": {
      "$value": "768px",
      "$description": "At or below this width the app switches to the two-view mobile layout. CSS media queries can't read variables, so main.css repeats this value; main.js reads it from here."
    },
    "landscape-height": {
      "$value": "500px",
      "$description": "Touch devices shorter than this (phones in landscape) also get the mobile layout"
    }
  },
  "z-index": {
    "$type": "number",
    "pane-label": {
      "$value": 3
    },
    "overlay": {
      "$value": 5,
      "$description": "Banner toast and HUD hint"
    },
    "panel": {
      "$value": 6,
      "$description": "Floating panels (desktop) and bottom sheets (mobile)"
    },
    "dock": {
      "$value": 8,
      "$description": "Mobile icon dock, always above sheets"
    }
  },
